# Required for embeddings
HF_TOKEN=your_huggingface_token

# Optional for answer generation
GROQ_API_KEY=your_groq_api_key

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://your-frontend-domain.up.railway.app,http://localhost:5173
# Optional: override origin regex if you use a custom frontend domain
CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$|^https://.*\.railway\.app$|^https://.*$|^http://localhost:5173$|^http://127\.0\.0\.1:5173$

# Keep this directory mounted as a Railway Volume for persistence
DATA_DIR=/data

# Clear data folders every 3 days
DATA_RESET_DAYS=3

# Check once per day while the app is running
DATA_RESET_CHECK_INTERVAL_HOURS=24

# Demo form email delivery (Gmail API OAuth)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REFRESH_TOKEN=your_google_oauth_refresh_token
GMAIL_SENDER_EMAIL=your_gmail_address@gmail.com
DEMO_RECEIVER_EMAIL=deoprakash364@gmail.com


